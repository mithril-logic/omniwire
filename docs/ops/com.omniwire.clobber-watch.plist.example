<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omniwire.clobber-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/admin/claude/omniwire/omniwire/scripts/clobber-watch.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>/Users/admin/.omniwire/logs/clobber-watch.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/.omniwire/logs/clobber-watch.err.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
